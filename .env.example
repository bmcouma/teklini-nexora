# Application
APP_ENV=development
APP_NAME=Teklini Nexora
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./nexora.db
# Production example:
# DATABASE_URL=postgresql+psycopg://nexora:changeme@localhost:5432/nexora

# Redis (optional, used for future task queue / caching)
REDIS_URL=redis://localhost:6379/0

# LLM Provider
# Supported: "heuristic" (no external calls, deterministic fallback reasoning)
#            "gemini" (requires GOOGLE_API_KEY and google-adk installed)
LLM_PROVIDER=heuristic
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20

# Workflow limits
MAX_DIAGNOSTIC_ITERATIONS=3
MAX_REVIEW_ITERATIONS=2

# Security / Auth
# Copy this file to .env and set a real secret before deployment.
NEXORA_SECRET_KEY=
NEXORA_API_KEY=
NEXORA_AUTH_REQUIRED=false

# If set to true in production, the app will reject unsigned requests to sensitive routes.
